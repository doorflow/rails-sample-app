# DoorFlow API Configuration
# Copy this file to .env and fill in your credentials

# OAuth 2.0 Client Credentials
# Get these from developer.doorflow.com/applications
DOORFLOW_CLIENT_ID=your_client_id_here
DOORFLOW_CLIENT_SECRET=your_client_secret_here
DOORFLOW_REDIRECT_URI=http://localhost:3333/api/auth/callback

# OAuth Scopes
DOORFLOW_SCOPES="account.person account.channel.readonly account.event.access.readonly"

# API Base URL (optional - defaults to https://api.doorflow.com)
# DOORFLOW_API_BASE=https://api.doorflow.com
