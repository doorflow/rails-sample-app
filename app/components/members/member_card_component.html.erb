<%= link_to member_path(member), class: card_classes, data: { turbo_frame: "_top" } do %>
  <div class="flex items-center gap-4">
    <%# Avatar - with image fallback like TypeScript %>
    <img
      src="<%= avatar_url %>"
      alt="<%= member.full_name %>"
      class="w-9 h-9 rounded-full object-cover flex-shrink-0"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
    <div class="w-9 h-9 rounded-full <%= avatar_bg_classes %> items-center justify-center font-bold text-xs flex-shrink-0 hidden">
      <%= avatar_fallback %>
    </div>

    <%# Name & Email - matches TypeScript minW and flex %>
    <div class="min-w-[200px] flex-1">
      <p class="font-semibold text-sm text-gray-800"><%= member.full_name %></p>
      <p class="text-xs text-gray-500"><%= member.email %></p>
    </div>

    <%# Membership Type Badge %>
    <span class="<%= membership_badge_classes %> flex-shrink-0">
      <%= member.membership_type %>
    </span>

    <%# Phone %>
    <span class="text-xs text-gray-500 min-w-[100px] flex-shrink-0">
      <%= member.phone.presence || "—" %>
    </span>

    <%# Sync Status %>
    <div class="flex-shrink-0">
      <%= render Members::SyncStatusBadgeComponent.new(doorflow_person_id: member.doorflow_person_id) %>
    </div>
  </div>
<% end %>
