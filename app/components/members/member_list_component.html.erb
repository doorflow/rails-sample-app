<div class="space-y-6">
  <%# Filter and Create Buttons - matches TypeScript styling %>
  <div class="bg-white p-4 rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.04)] border border-gray-100">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-sm font-semibold text-gray-600">Filter:</span>
        <div class="flex flex-wrap gap-2">
          <% filters.each do |f| %>
            <%= link_to members_path(filter: f[:value]),
                        class: filter_button_classes(f[:value]),
                        data: { turbo_frame: "members_list" } do %>
              <%= f[:label] %>
            <% end %>
          <% end %>
        </div>
      </div>
      <%= link_to new_member_path,
                  class: "px-4 py-2 bg-gradient-to-r from-purple-600 to-purple-800 text-white rounded-full text-sm font-bold hover:-translate-y-px hover:shadow-[0_4px_15px_rgba(102,126,234,0.35)] transition-all" do %>
        + New Member
      <% end %>
    </div>
  </div>

  <%# Member Count %>
  <p class="text-sm text-gray-500 font-medium"><%= member_count_text %></p>

  <%# Member List %>
  <turbo-frame id="members_list">
    <div class="space-y-3">
      <% if filtered_members.any? %>
        <% filtered_members.each do |member| %>
          <%= render Members::MemberCardComponent.new(member: member) %>
        <% end %>
      <% else %>
        <%# Empty State - matches TypeScript styling %>
        <div class="text-center py-16 bg-white rounded-2xl border border-gray-100">
          <div class="flex justify-center mb-4">
            <% if filter == "linked" %>
              <%= helpers.render_icon("link", css_class: "w-12 h-12 text-purple-500") %>
            <% elsif filter == "unlinked" %>
              <%= helpers.render_icon("lock-open", css_class: "w-12 h-12 text-gray-400") %>
            <% else %>
              <%= helpers.render_icon("users", css_class: "w-12 h-12 text-purple-500") %>
            <% end %>
          </div>
          <h3 class="text-lg font-semibold text-gray-700 mb-2">No Members Found</h3>
          <p class="text-gray-500">
            <% if filter == "all" %>
              No members in the CRM yet.
            <% elsif filter == "linked" %>
              No members are linked to DoorFlow yet.
            <% else %>
              All members are already linked to DoorFlow!
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  </turbo-frame>
</div>
