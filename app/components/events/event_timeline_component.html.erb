<% if loading? %>
  <div class="text-center py-8">
    <div class="animate-spin w-6 h-6 border-2 border-pink-500 border-t-transparent rounded-full mx-auto"></div>
    <p class="mt-3 text-sm text-gray-500">Loading events...</p>
  </div>

<% elsif error? %>
  <div class="p-4 rounded-xl bg-red-50">
    <p class="text-red-600 text-sm font-medium">
      Error loading events: <%= error %>
    </p>
  </div>

<% elsif empty? %>
  <div class="p-8 text-center bg-gray-50 rounded-xl">
    <div class="flex justify-center mb-2">
      <%= helpers.render_icon("bar-chart-3", css_class: "w-8 h-8 text-gray-400") %>
    </div>
    <p class="text-gray-500 font-medium">No recent access events.</p>
    <p class="text-gray-400 text-sm">Events will appear here when this person uses their credentials.</p>
  </div>

<% else %>
  <div class="space-y-0">
    <% events.each_with_index do |event, index| %>
      <% info = event_info(event[:event_code] || event["eventCode"] || 0) %>
      <% is_last = index == events.length - 1 %>

      <div class="flex items-start gap-4">
        <%# Timeline Dot & Line %>
        <div class="relative flex flex-col items-center">
          <div class="<%= dot_classes(info[:color]) %>">
            <%= helpers.render_icon(info[:icon], css_class: "w-4 h-4") %>
          </div>
          <% unless is_last %>
            <div class="w-0.5 flex-1 min-h-8 bg-gray-200"></div>
          <% end %>
        </div>

        <%# Event Content %>
        <div class="flex-1 <%= is_last ? '' : 'pb-6' %>">
          <div class="flex justify-between items-start mb-1">
            <span class="<%= badge_classes(info[:color]) %>">
              <%= info[:label] %>
            </span>
            <span class="text-xs text-gray-400">
              <%= format_timestamp(event[:timestamp] || event["timestamp"]) %>
            </span>
          </div>
          <p class="text-sm text-gray-700 font-medium">
            <%= event[:channel_name] || event["channelName"] || event[:door_controller_name] || event["doorControllerName"] || "Unknown location" %>
          </p>
          <% if (description = event[:description] || event["description"]).present? %>
            <p class="text-xs text-gray-500 mt-1"><%= description %></p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
