<div class="space-y-4" data-controller="team-select">
  <% if teams.any? %>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      <% teams.each do |team| %>
        <label class="<%= card_classes(team.id) %>" data-team-select-target="card">
          <input type="checkbox"
                 name="crm_member[crm_team_ids][]"
                 value="<%= team.id %>"
                 <%= "checked" if selected?(team.id) %>
                 class="sr-only"
                 data-action="team-select#toggle">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <p class="<%= team_name_classes(team.id) %>"><%= team.name %></p>
              <% if team.mapped? %>
                <p class="text-xs text-green-600">Mapped to group</p>
              <% else %>
                <p class="text-xs text-gray-400">Not mapped yet to a DoorFlow group</p>
              <% end %>
            </div>
            <div class="<%= checkbox_container_classes(team.id) %>">
              <% if selected?(team.id) %>
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              <% end %>
            </div>
          </div>
        </label>
      <% end %>
    </div>

    <%# Developer Note - matches TypeScript %>
    <%= render DevNoteComponent.new(variant: :code, title: "Team -> Group Sync") do %>
      Teams marked "Mapped to group" have a <code>doorflowGroupId</code>. During sync,
      member team assignments are converted to <code>groupIds</code> and sent to the API.
      Map teams to groups in <%= link_to "Settings", helpers.settings_path, class: "text-indigo-600 underline" %>.
    <% end %>
  <% else %>
    <div class="p-8 text-center bg-gray-50 rounded-xl">
      <div class="flex justify-center mb-2">
        <%= helpers.render_icon("users", css_class: "w-8 h-8 text-gray-400") %>
      </div>
      <p class="text-gray-500 font-medium mb-3">No teams created yet.</p>
      <%= link_to teams_path, class: "px-4 py-2 bg-gradient-to-r from-pink-400 to-red-400 text-white rounded-full text-sm font-bold hover:-translate-y-0.5 transition-all inline-block" do %>
        Create Teams
      <% end %>
    </div>
  <% end %>
</div>
