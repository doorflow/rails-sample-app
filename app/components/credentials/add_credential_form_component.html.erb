<% if credential_types.empty? %>
  <div class="text-center py-6">
    <div class="animate-spin w-5 h-5 border-2 border-green-500 border-t-transparent rounded-full mx-auto"></div>
    <p class="mt-2 text-sm text-gray-500">Loading credential types...</p>
  </div>
<% else %>
  <%= form_with url: helpers.api_doorflow_credentials_path, method: :post, data: { turbo: false, controller: "credential-form" } do |f| %>
    <%= f.hidden_field :person_id, value: person_id %>

    <div class="space-y-5">
      <%# Credential Type Selection %>
      <div>
        <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide mb-3">
          Credential Type
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          <% credential_types.each do |type| %>
            <% type_id = type[:id] || type["id"] %>
            <% type_label = type[:label] || type["label"] %>
            <% category = credential_category(type) %>
            <% is_assigned = type_already_assigned?(type_id) %>

            <label class="block cursor-<%= is_assigned ? 'not-allowed' : 'pointer' %> <%= is_assigned ? 'opacity-60' : '' %>"
                   data-credential-form-target="typeOption"
                   data-type-id="<%= type_id %>"
                   data-category="<%= category %>">
              <input type="radio"
                     name="credential_type_id"
                     value="<%= type_id %>"
                     class="hidden peer"
                     <%= 'disabled' if is_assigned %>
                     data-action="credential-form#selectType">
              <div class="p-4 rounded-xl border-2 text-center transition-all duration-200
                          <%= is_assigned ? 'border-gray-200 bg-gray-100' : 'border-gray-200 bg-white hover:border-gray-300' %>
                          peer-checked:border-green-400 peer-checked:bg-green-50">
                <div class="flex justify-center mb-2 <%= is_assigned ? 'text-gray-400' : 'text-gray-500 peer-checked:text-green-600' %>">
                  <%= helpers.render_icon(credential_icon(category), css_class: "w-6 h-6") %>
                </div>
                <p class="font-semibold text-sm <%= is_assigned ? 'text-gray-400' : 'text-gray-700' %>">
                  <%= type_label %>
                </p>
                <% if is_assigned %>
                  <p class="text-xs text-gray-400 mt-1">Already assigned</p>
                <% end %>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <%# Value Input Section - shown via JS based on selected type %>
      <div data-credential-form-target="cardInput" class="hidden">
        <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide mb-3">
          Card Number
        </p>
        <input type="text"
               name="value"
               placeholder="Enter card number"
               class="w-full px-4 py-3 rounded-xl border border-gray-200 font-mono text-lg focus:ring-2 focus:ring-green-500 focus:border-green-500">
      </div>

      <div data-credential-form-target="pinInput" class="hidden">
        <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide mb-3">
          PIN Code
        </p>
        <div class="flex gap-3 mb-3">
          <label class="flex-1 cursor-pointer">
            <input type="radio" name="pin_mode" value="auto" class="hidden peer" checked data-action="credential-form#togglePinMode">
            <div class="p-3 rounded-xl border-2 text-center transition-all
                        border-gray-200 bg-white hover:border-gray-300
                        peer-checked:border-green-400 peer-checked:bg-green-50">
              <div class="flex justify-center mb-1 text-gray-500 peer-checked:text-green-600">
                <%= helpers.render_icon("dices", css_class: "w-5 h-5") %>
              </div>
              <p class="text-sm font-medium text-gray-600 peer-checked:text-green-700">Auto-Generate</p>
            </div>
          </label>
          <label class="flex-1 cursor-pointer">
            <input type="radio" name="pin_mode" value="manual" class="hidden peer" data-action="credential-form#togglePinMode">
            <div class="p-3 rounded-xl border-2 text-center transition-all
                        border-gray-200 bg-white hover:border-gray-300
                        peer-checked:border-green-400 peer-checked:bg-green-50">
              <div class="flex justify-center mb-1 text-gray-500 peer-checked:text-green-600">
                <%= helpers.render_icon("pen-line", css_class: "w-5 h-5") %>
              </div>
              <p class="text-sm font-medium text-gray-600 peer-checked:text-green-700">Enter Manually</p>
            </div>
          </label>
        </div>

        <div data-credential-form-target="pinAutoMessage" class="p-4 bg-green-50 rounded-xl text-center">
          <p class="text-sm text-green-700 font-medium">A PIN will be auto-generated by DoorFlow</p>
        </div>

        <div data-credential-form-target="pinManualInput" class="hidden">
          <input type="text"
                 name="pin_value"
                 placeholder="Enter PIN (digits only)"
                 class="w-full px-4 py-3 rounded-xl border border-gray-200 font-mono text-lg focus:ring-2 focus:ring-green-500 focus:border-green-500">
        </div>
      </div>

      <div data-credential-form-target="mobileInput" class="hidden">
        <div class="p-4 bg-blue-50 rounded-xl">
          <div class="flex items-start gap-3">
            <%= helpers.render_icon("mail", css_class: "w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5") %>
            <div>
              <p class="font-semibold text-blue-800 text-sm">Invitation-Based Credential</p>
              <p class="text-blue-700 text-sm">An invitation will be sent to the person. No value is needed for mobile credentials.</p>
            </div>
          </div>
        </div>
      </div>

      <%# Submit Button %>
      <button type="submit"
              class="w-full py-3 px-6 bg-gradient-to-r from-teal-500 to-green-400 text-white font-bold rounded-xl
                     hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(56,239,125,0.35)] transition-all duration-200
                     disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
        Add Credential
      </button>

      <%# Developer Note %>
      <%= render DevNoteComponent.new(
        variant: :code,
        title: "Credential Types",
        sdk_method: "doorflow.credential_types.list"
      ) do %>
        Available credential types come from your DoorFlow account via the SDK. Each type
        has a <code>label</code> (display name) and <code>slug</code> (API identifier).
        A person can only have one credential of each type.
      <% end %>
    </div>
  <% end %>
<% end %>
