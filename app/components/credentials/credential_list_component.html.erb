<div class="space-y-3">
  <% if credentials.any? %>
    <% credentials.each do |credential| %>
      <% label = credential[:label] || credential[:type_name] %>
      <div class="p-4 bg-gray-50 rounded-xl border border-gray-100">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <%# Icon - colored based on type %>
            <div class="<%= icon_container_classes(label) %>">
              <%= helpers.render_icon(credential_icon(label), css_class: "w-5 h-5") %>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-semibold text-gray-800">
                  <%= label || "Type #{credential[:credential_type_id]}" %>
                </span>
                <% if credential[:status].present? %>
                  <span class="<%= status_badge_classes(credential[:status]) %>">
                    <%= credential[:status] %>
                  </span>
                <% end %>
                <% if credential[:wallet_type].present? %>
                  <span class="text-xs px-2 py-0.5 rounded-full font-bold bg-blue-100 text-blue-700">
                    <%= credential[:wallet_type] == "apple" ? "Apple Wallet" : "Google Wallet" %>
                  </span>
                <% end %>
              </div>
              <%# Display value or URL %>
              <% if credential[:url].present? %>
                <div class="flex items-center gap-1 mt-1">
                  <%= helpers.render_icon("external-link", css_class: "w-3 h-3 text-gray-400") %>
                  <a href="<%= credential[:url] %>"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="text-sm text-blue-600 font-mono hover:underline">
                    <%= credential_display_value(credential) %>
                  </a>
                </div>
              <% else %>
                <p class="text-sm text-gray-500 font-mono">
                  <%= credential_display_value(credential) %>
                </p>
              <% end %>
            </div>
          </div>
          <%# Delete button %>
          <% if person_id %>
            <%= button_to api_doorflow_credential_path(id: credential[:id]),
                          method: :delete,
                          class: "px-3 py-1.5 text-xs text-red-600 hover:bg-red-50 rounded-full font-medium transition-colors",
                          data: { confirm: "Are you sure you want to delete this credential?" } do %>
              Remove
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <%# Empty state - matches TypeScript styling %>
    <div class="p-8 text-center bg-gray-50 rounded-xl">
      <div class="flex justify-center mb-2 text-gray-400">
        <%= helpers.render_icon("credit-card", css_class: "w-8 h-8") %>
      </div>
      <p class="text-gray-500 font-medium">No credentials assigned yet.</p>
      <p class="text-gray-400 text-sm">Add a card or PIN to enable access.</p>
    </div>
  <% end %>
</div>
