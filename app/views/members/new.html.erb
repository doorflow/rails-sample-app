<% content_for(:title) { "New Member - DoorFlow Rails Demo" } %>

<div class="space-y-6">
  <%# Back Link %>
  <%= link_to members_path, class: "inline-flex items-center gap-1 text-gray-600 hover:text-gray-900" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Members
  <% end %>

  <h1 class="text-2xl font-bold text-gray-900">New Member</h1>

  <%= render "form", member: @member, teams: @teams %>
</div>
