<%= form_with model: member, url: (member.persisted? ? member_path(member) : members_path), multipart: true, class: "space-y-6" do |f| %>
  <% if member.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-red-800 font-medium mb-2">Please fix the following errors:</h3>
      <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
        <% member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 space-y-4">
    <h2 class="text-lg font-semibold text-gray-900">Photo</h2>

    <div class="flex items-center gap-6">
      <div class="w-24 h-24 rounded-xl bg-gray-100 overflow-hidden flex-shrink-0">
        <% if member.image_url %>
          <img src="<%= member.image_url %>" alt="<%= member.full_name %>" class="w-full h-full object-cover" />
        <% else %>
          <div class="w-full h-full flex items-center justify-center text-2xl font-bold text-gray-400">
            <%= member.persisted? ? member.initials : "?" %>
          </div>
        <% end %>
      </div>
      <div class="flex-1">
        <%= f.label :image_file, "Upload new photo", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.file_field :image_file, accept: "image/*", class: "w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100" %>
        <p class="text-xs text-gray-400 mt-1">JPG, PNG or GIF. Only sent to DoorFlow when changed.</p>
      </div>
    </div>

    <%= render DevNoteComponent.new(
      variant: :tip,
      title: "Image Sync Optimization",
      file_path: "app/models/crm_member.rb"
    ) do %>
      Images are only sent to the API when they change, not on every update. The SDK accepts
      <code>image_file</code> (path), <code>image_data</code> + <code>image_mime_type</code> (raw base64),
      or <code>image_base64</code> (data URI). The SDK converts all formats to the data URI format
      expected by the API.
    <% end %>
  </div>

  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 space-y-4">
    <h2 class="text-lg font-semibold text-gray-900">Basic Information</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :first_name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
      </div>

      <div>
        <%= f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :last_name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
      </div>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.telephone_field :phone, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
      </div>

      <div>
        <%= f.label :mobile, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.telephone_field :mobile, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 space-y-4">
    <h2 class="text-lg font-semibold text-gray-900">Work Details</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :department, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :department, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
      </div>

      <div>
        <%= f.label :job_title, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :job_title, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
      </div>
    </div>

    <div>
      <%= f.label :membership_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :membership_type, [["Standard", "standard"], ["Premium", "premium"]], {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
    </div>

    <div>
      <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :notes, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
    </div>
  </div>

  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Teams</h2>
    <%= render Teams::TeamSelectComponent.new(teams: teams, selected_team_ids: member.crm_team_ids) %>
  </div>

  <div class="flex items-center gap-4">
    <%= f.submit member.persisted? ? "Update Member" : "Create Member", class: "px-6 py-2 bg-purple-600 text-white rounded-lg font-medium hover:bg-purple-700 transition-colors cursor-pointer" %>
    <%= link_to "Cancel", member.persisted? ? member_path(member) : members_path, class: "px-6 py-2 bg-gray-100 text-gray-700 rounded-lg font-medium hover:bg-gray-200 transition-colors" %>
  </div>
<% end %>
