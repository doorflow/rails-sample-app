<%= form_with model: team, url: (team.persisted? ? team_path(team) : teams_path), class: "space-y-6" do |f| %>
  <% if team.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-red-800 font-medium mb-2">Please fix the following errors:</h3>
      <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
        <% team.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 space-y-4">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500" %>
    </div>
  </div>

  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 space-y-4">
    <h2 class="text-lg font-semibold text-gray-900">DoorFlow Group Mapping</h2>
    <p class="text-sm text-gray-500">Link this team to a DoorFlow group. Members of this team will be assigned to the selected group when synced.</p>

    <div>
      <%= f.label :doorflow_group_id, "DoorFlow Group", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% if @groups.any? %>
        <%= f.select :doorflow_group_id,
            @groups.map { |g| [g[:name], g[:id]] },
            { include_blank: "-- No mapping --" },
            class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500" %>
      <% else %>
        <p class="text-sm text-gray-400 italic">No DoorFlow groups available. Connect to DoorFlow first.</p>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-4">
    <%= f.submit team.persisted? ? "Update Team" : "Create Team", class: "px-6 py-2 bg-orange-600 text-white rounded-lg font-medium hover:bg-orange-700 transition-colors cursor-pointer" %>
    <%= link_to "Cancel", team.persisted? ? team_path(team) : teams_path, class: "px-6 py-2 bg-gray-100 text-gray-700 rounded-lg font-medium hover:bg-gray-200 transition-colors" %>
  </div>
<% end %>
