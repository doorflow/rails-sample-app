<% content_for(:title) { "New Team - DoorFlow Rails Demo" } %>

<div class="space-y-6">
  <%= link_to teams_path, class: "inline-flex items-center gap-1 text-gray-600 hover:text-gray-900" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Teams
  <% end %>

  <h1 class="text-2xl font-bold text-gray-900">New Team</h1>

  <%= render "form", team: @team %>
</div>
