<% content_for(:title) { "Teams - DoorFlow Rails Demo" } %>

<div class="space-y-6">
  <%# Header - matches TypeScript styling %>
  <div>
    <h1 class="text-2xl font-bold text-gray-800 mb-2">Teams</h1>
    <p class="text-gray-600">
      Create and manage CRM teams. Map them to DoorFlow groups in
      <%= link_to "Settings", settings_path, class: "text-purple-500 font-medium underline" %>.
    </p>
  </div>

  <%# Create Team Form - matches TypeScript styling %>
  <div class="bg-white rounded-2xl p-6 shadow-[0_4px_20px_rgba(0,0,0,0.08)]">
    <p class="font-bold text-gray-800 mb-4">Create New Team</p>
    <%= form_with url: teams_path, method: :post, local: true, class: "space-y-3" do |f| %>
      <input type="text"
             name="crm_team[name]"
             placeholder="Team name"
             required
             class="w-full px-4 py-3 text-lg border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none" />
      <input type="text"
             name="crm_team[description]"
             placeholder="Description (optional)"
             class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none" />
      <button type="submit"
              class="w-full px-6 py-3 bg-gradient-to-r from-purple-600 to-purple-800 text-white rounded-xl font-bold hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(102,126,234,0.35)] transition-all">
        Create Team
      </button>
    <% end %>
  </div>

  <%# Teams Grid - matches TypeScript card layout %>
  <% if @teams.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @teams.each do |team| %>
        <div class="bg-white rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.08)] overflow-hidden">
          <%# Team Header with gradient %>
          <div class="<%= team.mapped? ? 'bg-gradient-to-r from-teal-500 to-green-400' : 'bg-gradient-to-r from-purple-600 to-purple-800' %> px-5 py-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <%= render_icon("users", css_class: "w-5 h-5 text-white") %>
                <span class="font-bold text-white"><%= team.name %></span>
              </div>
              <% if team.mapped? %>
                <span class="px-2 py-0.5 bg-white/20 rounded-full text-xs text-white font-medium">
                  Mapped
                </span>
              <% end %>
            </div>
          </div>

          <%# Team Content %>
          <div class="p-5 space-y-4">
            <%# Description %>
            <p class="text-sm text-gray-600">
              <%= team.description.presence || "No description" %>
            </p>

            <%# DoorFlow Group Status %>
            <div>
              <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide mb-1">DoorFlow Group</p>
              <p class="text-sm font-medium <%= team.mapped? ? 'text-green-600' : 'text-gray-400' %>">
                <%= team.mapped? ? "Mapped (see Settings)" : "Not mapped" %>
              </p>
            </div>

            <%# Member Count %>
            <div>
              <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide mb-1">Members</p>
              <p class="text-sm font-medium text-gray-700">
                <%= team.crm_members.count %> total (<%= team.linked_members.count %> linked)
              </p>
            </div>

            <%# Actions %>
            <div class="flex justify-end gap-2 pt-2">
              <%= link_to edit_team_path(team), class: "px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-100 rounded-lg transition-colors" do %>
                Edit
              <% end %>
              <%= button_to team_path(team), method: :delete, data: { confirm: "Are you sure you want to delete this team?" }, class: "px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 rounded-lg transition-colors" do %>
                Delete
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# Empty State - matches TypeScript styling %>
    <div class="bg-white rounded-2xl p-10 text-center shadow-[0_4px_20px_rgba(0,0,0,0.08)]">
      <div class="flex justify-center mb-4">
        <%= render_icon("users", css_class: "w-12 h-12 text-purple-500") %>
      </div>
      <h3 class="text-lg font-semibold text-gray-700 mb-2">No Teams Yet</h3>
      <p class="text-gray-500">Create your first team to organize members and control access.</p>
    </div>
  <% end %>

  <%# Developer Note - matches TypeScript %>
  <%= render DevNoteComponent.new(variant: :code, title: "Team -> Group Mapping") do %>
    Teams are a CRM concept - DoorFlow uses groups for access control. Map each team
    to a DoorFlow group in <%= link_to "Settings", settings_path, class: "text-indigo-600 underline" %>. When members are synced,
    their team memberships are converted to <code>groupIds</code> and sent to the API.
  <% end %>
</div>
