<div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-800 space-y-2">
  <div class="font-semibold text-sm">Couldn't mint a session.</div>
  <div class="text-xs font-mono"><%= result.error %></div>
  <% if result.detail.present? %>
    <pre class="text-xs whitespace-pre-wrap"><%= result.detail %></pre>
  <% end %>
  <% if result.error == :member_not_synced %>
    <div class="text-xs">Run a member sync from <%= link_to "Settings", settings_path, class: "underline font-semibold" %>, then reload.</div>
  <% elsif result.error == :doorflow_not_connected || result.error == :no_access_token %>
    <div class="text-xs">Connect to DoorFlow from <%= link_to "Settings", settings_path, class: "underline font-semibold" %>, then reload.</div>
  <% end %>
</div>
